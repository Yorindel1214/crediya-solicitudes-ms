meta {
  name: 11 - Listar por estado
  type: http
  seq: 14
}

get {
  url: http://localhost:8081/api/v1/solicitud?estado=PENDIENTE_REVISION&tamano=5
  body: none
  auth: bearer
}

params:query {
  estado: PENDIENTE_REVISION
  tamano: 5
}

auth:bearer {
  token: {{tokenAsesor}}
}

tests {
  test("responde 200 y solo trae pendientes", function () {
    expect(res.getStatus()).to.equal(200);
    res.getBody().contenido.forEach((s) => expect(s.estado_solicitud).to.equal("Pendiente de revisión"));
  });

  test("respeta el tamaño de página", function () {
    expect(res.getBody().contenido.length).to.be.at.most(5);
  });
}