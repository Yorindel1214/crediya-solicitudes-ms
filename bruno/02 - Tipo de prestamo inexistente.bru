meta {
  name: 02 - Tipo de prestamo inexistente
  type: http
  seq: 2
}

post {
  url: http://localhost:8081/api/v1/solicitud
  body: json
  auth: none
}

body:json {
  {
    "documento_identidad": "1023456789",
    "monto": 5000000,
    "plazo_meses": 24,
    "id_tipo_prestamo": 99
  }
}

tests {
  test("responde 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("explica que el tipo no existe", function () {
    expect(res.getBody().error).to.equal("El tipo de préstamo con id 99 no existe");
  });
}

docs {
  Criterio: el tipo de préstamo debe ser uno de los existentes. Esperado: 400.
}
