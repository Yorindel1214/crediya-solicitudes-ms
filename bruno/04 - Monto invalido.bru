meta {
  name: 04 - Monto invalido
  type: http
  seq: 4
}

post {
  url: http://localhost:8081/api/v1/solicitud
  body: json
  auth: none
}

body:json {
  {
    "documento_identidad": "1023456789",
    "monto": 0,
    "plazo_meses": 24,
    "id_tipo_prestamo": 1
  }
}

tests {
  test("responde 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("explica que el monto debe ser positivo", function () {
    expect(res.getBody().error).to.equal("El monto debe ser mayor que 0");
  });
}

docs {
  Criterio: se valida la información del préstamo (monto). Esperado: 400.
}
