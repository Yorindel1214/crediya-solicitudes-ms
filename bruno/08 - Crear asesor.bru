meta {
  name: 08 - Crear asesor
  type: http
  seq: 11
}

post {
  url: http://localhost:8080/api/v1/usuarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombres": "Sofia",
    "apellidos": "Asesora",
    "correo_electronico": "{{correoAsesor}}",
    "documento_identidad": "{{documentoAsesor}}",
    "clave": "Asesor12345",
    "rol": "ASESOR",
    "salario_base": 4000000
  }
}

script:pre-request {
  const sufijo = String(Date.now()).slice(-9);
  bru.setVar("correoAsesor", "asesor" + sufijo + "@crediya.com");
  bru.setVar("documentoAsesor", "7" + sufijo);
}

tests {
  test("responde 201 Created", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Preparación HU4: el administrador crea un ASESOR (microservicio de Autenticación).
}