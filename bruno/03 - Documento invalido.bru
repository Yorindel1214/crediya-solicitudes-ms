meta {
  name: 03 - Documento invalido
  type: http
  seq: 3
}

post {
  url: http://localhost:8081/api/v1/solicitud
  body: json
  auth: none
}

body:json {
  {
    "documento_identidad": "ABC123",
    "monto": 5000000,
    "plazo_meses": 24,
    "id_tipo_prestamo": 1
  }
}

tests {
  test("responde 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("explica el formato del documento", function () {
    expect(res.getBody().error).to.equal("El documento de identidad debe tener solo números, entre 6 y 15 dígitos");
  });
}

docs {
  Criterio: se valida la información del cliente (documento de identidad). Esperado: 400.
}
